{
  "name": "ccwrapped",
  "version": "1.1.0",
  "description": "Claude Code Wrapped: a local, in-browser year-in-review of your Claude Code transcripts. Unofficial; not affiliated with Anthropic.",
  "type": "module",
  "bin": {
    "ccwrapped": "bin/ccwrapped.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "js/",
    "css/",
    "index.html",
    "og.png",
    "server.mjs"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "claude-code",
    "claude",
    "wrapped",
    "spotify-wrapped",
    "year-in-review",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenpasdan1-ai/claude-code-wrapped.git"
  },
  "homepage": "https://zenpasdan1-ai.github.io/claude-code-wrapped/",
